# Copy to .env.local for local development.
# API base URL: docker compose exposes http://localhost:7001,
# `dotnet run` exposes https://localhost:7001 and http://localhost:5001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001
# Public site URL used for sitemap/robots/canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
