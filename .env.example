# WhatTheGym local environment (copy to .env; never commit .env)
# Public browsing works without cloud secrets. Login requires the Google secret below.

# PostgreSQL
POSTGRES_DB=whatthegym
POSTGRES_USER=wtg
POSTGRES_PASSWORD=wtg_dev_password
# Host port; PostgreSQL still listens on 5432 inside the Compose network.
POSTGRES_PORT=5433

# API behaviour
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=false
# The verified Google email that becomes the first Admin on login.
BOOTSTRAP_ADMIN_EMAIL=whatthegym1@gmail.com

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Used by the Next.js app to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth uses the staging web client. Add this authorized redirect URI in
# Google Cloud: http://localhost:7001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=505244859145-clbp2iurv5qucqaqcq6t0v4eeeed1g23.apps.googleusercontent.com
# Copy the staging client's secret into .env. Never commit it.
GOOGLE_CLIENT_SECRET=

# Resend transactional mail (leave the key empty to log mails locally)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@mail.whatthegym.at
MAIL_FROM_NAME=WhatTheGym

# Analytics session bucket hashing secret (rotate in production)
ANALYTICS_HASH_SECRET=local-dev-analytics-secret

# pgAdmin (optional, profile "tools")
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
