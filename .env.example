# WhatTheGym local environment (copy to .env; never commit .env)
# No cloud accounts or secrets are required for local development.

# PostgreSQL
POSTGRES_DB=whatthegym
POSTGRES_USER=wtg
POSTGRES_PASSWORD=wtg_dev_password

# API behaviour
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=true
ENABLE_DEV_LOGIN=true
# The verified Google email that becomes the first Admin on login (dev-login works too).
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Used by the Next.js app to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001

# Google OAuth (leave empty locally; the dev-login replaces it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend transactional mail (leave empty locally; mails are logged instead)
RESEND_API_KEY=

# Analytics session bucket hashing secret (rotate in production)
ANALYTICS_HASH_SECRET=local-dev-analytics-secret

# pgAdmin (optional, profile "tools")
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
